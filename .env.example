# Mapbox public access token. Create one at https://account.mapbox.com/access-tokens/
# Restrict the token to your deployed origins (e.g. boatbuddy.app, localhost).
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token-here

# Default style URL. Use a Mapbox-hosted nautical-friendly style or your own
# custom style id (e.g. mapbox://styles/your-org/your-marine-style).
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/outdoors-v12
